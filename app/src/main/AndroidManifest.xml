<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.android.updater" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.systemui" />
        <package android:name="com.miui.home" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.android.calendar" />
        <package android:name="com.miui.weather2" />
        <package android:name="com.mi.health" />
        <package android:name="com.android.stk" />
        <package android:name="com.miui.voiceassist" />
        <package android:name="com.miui.screenshot" />
        <package android:name="com.mobiletools.systemhelper" />
        <package android:name="com.miui.dmregservice" />
        <package android:name="com.miui.analytics" />
    </queries>
    <application android:name=".HypernovaApp" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name" android:description="@string/module_description"
        android:icon="@mipmap/ic_hypernova" android:supportsRtl="true"
        android:theme="@style/Theme.Hypernova">
        <activity android:name=".ui.MainActivity" android:exported="true" android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="io.github.libxposed.service.XposedProvider"
            android:permission="android.permission.MANAGE_USERS" android:directBootAware="true" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/module_description" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedsharedprefs" android:value="true" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
